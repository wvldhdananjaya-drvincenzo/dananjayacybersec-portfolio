rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero-Trust Default Deny: deny all read/write across collections unless explicitly authorized
    match /{document=**} {
      allow read, write: if false;
    }

    // Projects endorsements/metadata - public read-only
    // Client-side writes are strictly forbidden; writes only permitted via validated server API
    match /projects/{projectId} {
      allow read: if true;
      allow write: if false;
    }

    // Contact form submissions - unauthenticated users can NEVER read or list inquiries
    // Only verified administrators with admin claims can access
    match /contact_inquiries/{inquiryId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // User profiles - authenticated user isolation
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
